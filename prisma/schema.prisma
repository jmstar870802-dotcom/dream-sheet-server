// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider  = "postgresql"
}

model Sheet{
  id  Int @id @default(autoincrement())
  title String
  key String
  lyrics String
  notation String
  img_url String
  createdAt DateTime @default(now()) 
  updatedAt DateTime @default(now()) 

  Conti Conti[]
}

model Conti{
  id  Int @id @default(autoincrement())
  contiDate String
  contiNote String
  contiNotation String
  conti_img_url String
  createdAt DateTime @default(now()) 
  updatedAt DateTime @default(now()) 

  SheetId Int
  sheet Sheet @relation(fields: [SheetId], references: [id], onDelete: Cascade)
  
}

model Member {
  id Int @id @default(autoincrement())
  userName String
  birthday  String
  mngrSe String

  leaderMember LeaderMember[]
}

model LeaderMember {
  id Int @id @default(autoincrement())
  LeaderId Int @unique
  UseYn String

  member Member @relation(fields: [LeaderId], references: [id], onDelete: Cascade)
  cellMember CellMember[]
  reportHeader ReportHeader[]
}

model CellMember{
  id Int @id @default(autoincrement())
  MemberId Int @unique

  LeaderId Int 
  leaderMember LeaderMember @relation(fields: [LeaderId], references: [LeaderId], onDelete: Cascade)
}

model ReportHeader{
  id Int @id @default(autoincrement())

  writeDt String
  meetingPlace String
  bigoMaster String
  
  LeaderId Int 
  leaderMember LeaderMember @relation(fields: [LeaderId], references: [LeaderId], onDelete: Cascade)

  reportContent ReportContent[]
}

model ReportContent{
  id Int @id @default(autoincrement())
  memberNm String
  wesDay Boolean
  sundayAf Boolean
  sundayNt Boolean
  cellMeeting Boolean
  bigo String

  reportId Int
  reportHeader ReportHeader @relation(fields: [reportId], references: [id], onDelete: Cascade)
}
